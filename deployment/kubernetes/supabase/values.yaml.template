secret:
  jwt:
    anonKey:    "${ANON_KEY}"
    serviceKey: "${SERVICE_KEY}"
    secret:     "${JWT_SECRET}"
  db:
    password: "${DB_PASS}"
    database: postgres
  dashboard:
    username: supabase
    password: "${DASH_PASS}"
  analytics:
    publicAccessToken:  "${LOGFLARE_PUB}"
    privateAccessToken: "${LOGFLARE_PRIV}"
  smtp:
    username: ""
    password: ""

deployment:
  vector:    { enabled: false }
  analytics: { enabled: false }
  auth:      { enabled: true }
  db:        { enabled: true }
  functions: { enabled: true }
  imgproxy:  { enabled: true }
  kong:      { enabled: true }
  meta:      { enabled: true }
  minio:     { enabled: true }
  realtime:  { enabled: true }
  rest:      { enabled: true }
  storage:   { enabled: true }
  studio:    { enabled: true }

persistence:
  db:      { enabled: true, storageClassName: longhorn, size: 10Gi, annotations: {} }
  storage: { enabled: true, storageClassName: longhorn, size: 10Gi, annotations: {} }
  minio:   { enabled: true, storageClassName: longhorn, size: 10Gi, annotations: {} }

envs:
  studio:
    SUPABASE_URL:              "http://ai-listings-supabase-kong:8000"
    STUDIO_PG_META_URL:        "http://ai-listings-supabase-meta:8080"
    NEXT_PUBLIC_ENABLE_LOGS:   "false"
  auth:
    # Supabase refresh tokens are single-use. This app's proxy (src/proxy.ts) refreshes the
    # session on every request, and the browser client also auto-refreshes independently --
    # two parallel requests carrying the same not-yet-rotated refresh token (e.g. a page load
    # firing several client-side fetch() calls at once) will race: the loser's refresh is
    # rejected by GoTrue as token reuse, which can present as a hard, seemingly-random logout.
    # This is a documented, expected limitation of @supabase/ssr (see its README's "Concurrent
    # requests with the same expired session" section), not a bug in this app's code. GoTrue's
    # reuse-interval grace period is the built-in mitigation -- widened from its default
    # (commonly ~10s) to comfortably absorb this app's typical per-navigation request bursts.
    GOTRUE_SECURITY_REFRESH_TOKEN_REUSE_INTERVAL: "30"

ingress:
  enabled: false

autoscaling:
  analytics:   { enabled: false }
  auth:        { enabled: false }
  db:          { enabled: false }
  functions:   { enabled: false }
  imgproxy:    { enabled: false }
  kong:        { enabled: false }
  meta:        { enabled: false }
  minio:       { enabled: false }
  realtime:    { enabled: false }
  rest:        { enabled: false }
  storage:     { enabled: false }
  studio:      { enabled: false }
  vector:      { enabled: false }

controller:
  type: StatefulSet
